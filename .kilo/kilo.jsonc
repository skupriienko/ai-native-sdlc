{
  "$schema": "https://raw.githubusercontent.com/Kilo-Org/kilocode/main/schemas/kilo.json",
  "version": "1.0.0",
  "name": "ai-native-sdlc",
  "description": "6-Phase Artifact Loop Engine & Spec-Driven Development Framework for AI Coding Agents",
